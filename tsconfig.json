{
  "extends": "fastify-tsconfig",
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "target": "ES2023",
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
  },
  "include": ["src/**/*.ts"]
}
